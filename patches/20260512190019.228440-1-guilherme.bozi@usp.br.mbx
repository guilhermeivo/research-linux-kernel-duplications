>  .../dc/gpio/dcn32/hw_translate_dcn32.c        | 386 +++++---------
>  .../dc/gpio/dcn401/hw_translate_dcn401.c      | 392 +++++---------
>  .../dc/gpio/dcn42/hw_translate_dcn42.c        | 193 +++----
>  .../drm/amd/display/dc/gpio/hw_translate.c    |  86 ++++
